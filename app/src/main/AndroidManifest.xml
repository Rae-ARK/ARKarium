<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arkarium.app">

    <!-- Needed for the "Fetch info" metadata lookup (Google Books API) and for loading
         remote cover thumbnails via Coil. The app is otherwise fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runtime-requested (see MainActivity's notificationPermission launcher) rather
         than implied by targeting API 33+ - required to actually show the "new chapter"
         notifications NewChapterCheckWorker posts (see
         docs/foundational/architecture.md, Sync: entry points). Declaring it here is still required even
         though it's requested at runtime; without it the runtime request itself is a
         no-op on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TtsPlaybackService (see docs/proposal/reader-playback.md F10) runs
         read-aloud as a foreground service so an active session survives rotation and
         leaving the reader, instead of dying with the composable that used to own the
         TextToSpeech engine directly. FOREGROUND_SERVICE is required for any foreground
         service on API 28+; FOREGROUND_SERVICE_MEDIA_PLAYBACK is required in addition,
         on API 34+, for a service declaring android:foregroundServiceType="mediaPlayback"
         (see the <service> entry below) - both are normal, install-time-granted
         permissions, nothing to prompt for at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Micro-haptics (util/Haptics.kt): chapter-complete, sync-done, and TTS
         start/stop each fire one short Vibrator.vibrate() call. Normal,
         install-time-granted permission - nothing to prompt for at runtime. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Package-visibility declarations (API 30+) for MainActivity.
         openLibraryFolderInFileManager (LibrarySettingsScreen's "Open library folder
         in file manager" action). Without these, Intent.resolveActivity /
         PackageManager.queryIntentActivities always reports "no activity found" for
         this ACTION_VIEW intent - even when a perfectly good file manager is
         installed - because the system hides other apps' manifests from this one by
         default. Two mime types since file managers are split roughly evenly
         between treating a folder Uri as "resource/folder" (the one this app's own
         Intent declares - see that function) and the SAF-native
         "vnd.android.document/directory". -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="resource/folder" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
    </queries>

    <application
        android:name=".ArkariumApp"
        android:allowBackup="true"
        android:label="ARKarium"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ARKarium"
        android:enableOnBackInvokedCallback="true">
        <!-- launchMode="singleTop" so tapping a "new chapter" notification (see
             NewChapterNotifier's PendingIntent) delivers straight into onNewIntent()
             on an already-running instance instead of spawning a second MainActivity
             on top of it - see MainActivity.onNewIntent. -->
        <activity android:name="com.arkarium.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Static app shortcuts (long-press the launcher icon on API 25+ - a
                 no-op, not a crash, on minSdk 24 itself). See res/xml/shortcuts.xml
                 for "Continue Reading" and MainActivity's
                 EXTRA_CONTINUE_READING_SHORTCUT/handleShortcutIntent for how its tap
                 is handled. -->
            <meta-data android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Not exported - only this app binds to it (see ui/Tts.kt's rememberChapterTts).
             foregroundServiceType="mediaPlayback" is what lets startForeground() succeed
             with a media-playback-typed notification on API 29+, and is required
             alongside the FOREGROUND_SERVICE_MEDIA_PLAYBACK permission above on API 34+. -->
        <service android:name="com.arkarium.app.playback.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Backs MainActivity.openLibraryFolderInFileManager (LibrarySettingsScreen's
             "Open library folder in file manager" action) - mints a content:// Uri for
             the library root (see res/xml/file_paths.xml) so it can be handed to
             another app's Intent without a file:// StrictMode violation. Not exported
             (grantUriPermissions + the per-call FLAG_GRANT_READ_URI_PERMISSION are the
             only way another app ever sees a Uri from this provider), same posture as
             TtsPlaybackService above. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
