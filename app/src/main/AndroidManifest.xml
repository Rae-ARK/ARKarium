<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arkarium.app">

    <!-- Needed for the "Fetch info" metadata lookup (Google Books API) and for loading
         remote cover thumbnails via Coil. The app is otherwise fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Runtime-requested (see MainActivity's notificationPermission launcher) rather
         than implied by targeting API 33+ - required to actually show the "new chapter"
         notifications NewChapterCheckWorker posts (see
         docs/arkarium/foundational/architecture.md, Sync: entry points). Declaring it here is still required even
         though it's requested at runtime; without it the runtime request itself is a
         no-op on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- TtsPlaybackService (see docs/arkarium/proposal/reader-playback.md F10) runs
         read-aloud as a foreground service so an active session survives rotation and
         leaving the reader, instead of dying with the composable that used to own the
         TextToSpeech engine directly. FOREGROUND_SERVICE is required for any foreground
         service on API 28+; FOREGROUND_SERVICE_MEDIA_PLAYBACK is required in addition,
         on API 34+, for a service declaring android:foregroundServiceType="mediaPlayback"
         (see the <service> entry below) - both are normal, install-time-granted
         permissions, nothing to prompt for at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <application
        android:allowBackup="true"
        android:label="ARKarium"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.ARKarium">
        <!-- launchMode="singleTop" so tapping a "new chapter" notification (see
             NewChapterNotifier's PendingIntent) delivers straight into onNewIntent()
             on an already-running instance instead of spawning a second MainActivity
             on top of it - see MainActivity.onNewIntent. -->
        <activity android:name="com.arkarium.app.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Not exported - only this app binds to it (see ui/Tts.kt's rememberChapterTts).
             foregroundServiceType="mediaPlayback" is what lets startForeground() succeed
             with a media-playback-typed notification on API 29+, and is required
             alongside the FOREGROUND_SERVICE_MEDIA_PLAYBACK permission above on API 34+. -->
        <service android:name="com.arkarium.app.playback.TtsPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
    </application>

</manifest>
