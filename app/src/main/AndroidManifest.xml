<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.arkarium.app">

    <!-- Needed for the "Fetch info" metadata lookup (Google Books API) and for loading
         remote cover thumbnails via Coil. The app is otherwise fully offline. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="ARKarium"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name="com.arkarium.app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
