<?xml version="1.0" encoding="utf-8"?>
<!-- Intentionally empty. "Continue Reading" used to be declared here as a *static*
     shortcut, but static shortcuts can't carry custom Intent flags - Android always
     launches them with FLAG_ACTIVITY_NEW_TASK | FLAG_ACTIVITY_CLEAR_TASK, which tore
     down the running MainActivity (and its ViewModelStore/NavController) before the
     shortcut's intent was delivered, making onNewIntent() unreachable and turning
     every shortcut tap into a disguised cold start.
     It's now published as a DYNAMIC shortcut instead, from
     ArkariumApp.publishContinueReadingShortcut(), which can specify
     FLAG_ACTIVITY_SINGLE_TOP | FLAG_ACTIVITY_CLEAR_TOP and so lets MainActivity's
     launchMode="singleTop" + onNewIntent()/handleShortcutIntent() actually do their
     job. The <meta-data android:resource="@xml/shortcuts"/> entry stays in
     AndroidManifest.xml (an app is allowed to declare zero static shortcuts here;
     removing the meta-data entirely isn't required and isn't worth the churn). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android" />
